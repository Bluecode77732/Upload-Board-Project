# compiled output
/dist
/node_modules
# .node_modules
/build

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
/coverage
/.nyc_output

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# temp directory
.temp
.tmp

# Uploaded media — runtime artifacts under file/temp and file/upload, never committed
/file/

# Session log — locally auto-appended by .claude/hooks/log-session-start.js and
# log-session-title.js on every SessionStart/UserPromptSubmit; grows and churns
# per developer machine, so it is local-only, not shared via git
/docs/SESSION-LOG.md
/docs/SESSION-LOG.ko.md

# Playwright MCP scratch output — page/console dumps the browser MCP server writes during
# live UI verification (CLAUDE.md > Development Tooling > MCP Servers). Per-session and
# per-machine, like the session log above; no slash prefix so it also covers
# frontend/.playwright-mcp/ and admin/.playwright-mcp/
.playwright-mcp/

# Ad-hoc verification screenshots dropped at the repo root by that same browser tooling.
# Scoped to the root only: the repo tracks no image assets today, and any that are ever
# added belong beside the code that uses them, never here
/*.png
/*.jpg
/*.jpeg
/*.webp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Terraform — local provider/module cache and state; .terraform.lock.hcl is
# deliberately NOT ignored (committed for reproducibility, like pnpm-lock.yaml, ADR 0014)
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
