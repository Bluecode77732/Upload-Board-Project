{
  "enabledMcpjsonServers": ["playwright", "context7"],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/log-session-start.js 2>/dev/null || true",
            "statusMessage": "Logging session start..."
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/log-session-start.js 2>/dev/null || true",
            "statusMessage": "Logging session resume..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/log-session-title.js 2>/dev/null || true",
            "statusMessage": "Recording session title..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-ko-sibling.js 2>/dev/null || true",
            "statusMessage": "Checking .ko.md sibling..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-blast-radius.js 2>/dev/null || true",
            "statusMessage": "Checking high-blast-radius file list..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-migration-generate.js 2>/dev/null || true",
            "statusMessage": "Checking migration:generate precondition..."
          }
        ]
      }
    ]
  }
}
