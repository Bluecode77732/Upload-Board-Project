# Development Environment
ENV=dev

# DB configuration
DB_TYPE=yourDatabase
DB_HOST=yourDatabase
DB_PORT=yourPort
DB_USERNAME=yourDBport
DB_PASSWORD=yourDBpassword
DB_DATABASE=yourDBtype

# TLS to the DB (optional, ADR 0039) — set true when the target instance enforces
# encrypted connections (e.g. RDS PostgreSQL's default rds.force_ssl=1). Defaults to
# false. DB_SSL_CA is required whenever DB_SSL=true — the PEM contents of the CA that
# signed the DB's certificate (AWS publishes one per RDS region, e.g.
# https://truststore.pki.rds.amazonaws.com/<region>/<region>-bundle.pem). Never set
# rejectUnauthorized:false instead — ADR 0039 rejected that outright.
# DB_SSL=false
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Hash
HASH_ROUNDS=hashRounds

# Secret Token
REFRESH_TOKEN_SECRET=yourEncodedSecretKey
ACCESS_TOKEN_SECRET=yourEncodedSecretKey

# Expiry
REFRESH_TOKEN_SECRET_EXPIRES_IN=expiryTime
ACCESS_TOKEN_SECRET_EXPIRES_IN=expiryTime

# Public base URL (optional) — composes file URLs in responses; defaults to http://localhost:3000
# BASE_URL=http://localhost:3000

# HTTP listen port (optional) — defaults to 3000
# PORT=3000

# CORS (optional) — comma-separated browser origins; leave unset to keep CORS disabled
# CORS_ORIGIN=http://localhost:5173

# Superadmin seed (optional) — this account is promoted to superadmin on boot (ADR 0013);
# leave unset to disable. Register the account first, then set this and restart.
# SUPERADMIN_EMAIL=admin@example.com

# Orphan temp-file sweep (optional, ADR 0018) — deletes unclaimed temp_ uploads
# left in file/temp when POST /file is never called. All have safe defaults.
# TEMP_SWEEP_ENABLED=true          # set false to skip registering the cron (e.g. tests)
# TEMP_SWEEP_CRON=0 * * * *        # schedule; default hourly
# TEMP_SWEEP_TTL_HOURS=24          # a temp_ file older than this is an orphan
# TEMP_SWEEP_DRY_RUN=false         # true logs the deletion targets without deleting

# 고아 granted 파일 회수(선택, ADR 0051) — file_entity 행이 없는 file/upload 바이트(커밋 후
# unlink 실패, 또는 레이스)를 찾으려고 DB와 대조해 훑는다. 위 temp 파일을 훑는 것과 달리
# DRY_RUN 기본값은 true다: 판정 로직이 실전에서 검증되기 전까지는 리포트만 한다 — 오탐이
# 실제 소유된 파일을 파괴하기 때문이다.
# GRANTED_SWEEP_ENABLED=true            # false면 크론 등록을 건너뜀(예: 테스트)
# GRANTED_SWEEP_CRON=0 0 * * *           # 스케줄; 기본값은 매일 자정
# GRANTED_SWEEP_DRY_RUN=true             # false면 실제로 삭제함; 신뢰 전까지는 true 유지

# Storage port-adapter (optional, ADR 0029) — selects the FileStorage implementation.
# Defaults to local disk (ADR 0005 behavior, unchanged). S3_BUCKET/AWS_REGION are only
# required when STORAGE_DRIVER=s3. AWS credentials are NOT read via ConfigService — the
# AWS SDK's own default provider chain resolves them, one option being these two env vars
# (shared config file / IAM role also work; only needed when STORAGE_DRIVER=s3).
# STORAGE_DRIVER=local             # 'local' | 's3'
# S3_BUCKET=your-bucket-name       # required when STORAGE_DRIVER=s3
# AWS_REGION=ap-northeast-2        # required when STORAGE_DRIVER=s3
# AWS_ACCESS_KEY_ID=yourAwsAccessKeyId
# AWS_SECRET_ACCESS_KEY=yourAwsSecretAccessKey

# 로컬 전용 오버라이드: ConfigModule이 .env.local을 .env보다 먼저 읽으므로
# (backend/app.module.ts의 envFilePath: ['.env.local', '.env']), 로컬에서만
# STORAGE_DRIVER를 바꿔 테스트하고 싶으면 .env는 그대로 두고 .env.local에
# STORAGE_DRIVER=s3 한 줄만 넣으면 된다. .env.local은 .gitignore에 이미
# 등록되어 커밋되지 않는다.

# Presigned-redirect TTL for GET /file/:id/content under STORAGE_DRIVER=s3 (ADR 0036).
# Unused under STORAGE_DRIVER=local.
# CONTENT_SIGNED_URL_TTL_SECONDS=300
