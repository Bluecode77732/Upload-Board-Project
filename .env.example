# 개발 환경
ENV=dev

# DB 설정
DB_TYPE=yourDatabase
DB_HOST=yourDatabase
DB_PORT=yourPort
DB_USERNAME=yourDBport
DB_PASSWORD=yourDBpassword
DB_DATABASE=yourDBtype

# DB TLS(선택, ADR 0039) — 대상 인스턴스가 암호화 연결을 강제할 때(예: RDS PostgreSQL
# 기본값인 rds.force_ssl=1) true로 설정한다. 기본값은 false. DB_SSL=true면 DB_SSL_CA가
# 필수다 — DB 인증서에 서명한 CA의 PEM 내용(AWS가 리전별로 하나씩 공개한다, 예:
# https://truststore.pki.rds.amazonaws.com/<region>/<region>-bundle.pem). 대신
# rejectUnauthorized:false를 쓰지 말 것 — ADR 0039가 이를 명시적으로 기각했다.
# DB_SSL=false
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# 해시
HASH_ROUNDS=hashRounds

# 시크릿 토큰
REFRESH_TOKEN_SECRET=yourEncodedSecretKey
ACCESS_TOKEN_SECRET=yourEncodedSecretKey

# 만료 시간
REFRESH_TOKEN_SECRET_EXPIRES_IN=expiryTime
ACCESS_TOKEN_SECRET_EXPIRES_IN=expiryTime

# 공개 base URL(선택) — 응답의 파일 URL을 구성한다; 기본값은 http://localhost:3000
# BASE_URL=http://localhost:3000

# HTTP 리슨 포트(선택) — 기본값은 3000
# PORT=3000

# CORS(선택) — 콤마로 구분한 브라우저 origin 목록; 설정하지 않으면 CORS는 꺼진 채로 있다
# CORS_ORIGIN=http://localhost:5173

# Superadmin 대상 계정(선택, ADR 0013 + ADR 0052) — 이 값 자체는 아무것도 자동으로
# 하지 않는다. 계정을 먼저 등록한 뒤, `pnpm promote-superadmin`을 직접 실행해야
# 그 계정이 superadmin으로 승격된다(부팅 시 자동 승격은 신원 미검증 취약점으로
# 2026-09-09 제거됨).
# SUPERADMIN_EMAIL=admin@example.com

# 고아 temp 파일 정리(선택, ADR 0018) — POST /file이 끝내 호출되지 않아 file/temp에
# 남은 미claim 업로드를 삭제한다. 전부 안전한 기본값을 가진다.
# TEMP_SWEEP_ENABLED=true          # false면 크론 등록을 건너뜀(예: 테스트)
# TEMP_SWEEP_CRON=0 * * * *        # 스케줄; 기본값은 매시간
# TEMP_SWEEP_TTL_HOURS=24          # 이보다 오래된 temp_ 파일은 고아로 본다
# TEMP_SWEEP_DRY_RUN=false         # true면 삭제하지 않고 대상만 로그로 남긴다

# 고아 granted 파일 회수(선택, ADR 0051) — file_entity 행이 없는 file/upload 바이트(커밋 후
# unlink 실패, 또는 레이스)를 찾으려고 DB와 대조해 훑는다. 위 temp 파일을 훑는 것과 달리
# DRY_RUN 기본값은 true다: 판정 로직이 실전에서 검증되기 전까지는 리포트만 한다 — 오탐이
# 실제 소유된 파일을 파괴하기 때문이다.
# GRANTED_SWEEP_ENABLED=true            # false면 크론 등록을 건너뜀(예: 테스트)
# GRANTED_SWEEP_CRON=0 0 * * *           # 스케줄; 기본값은 매일 자정
# GRANTED_SWEEP_DRY_RUN=true             # false면 실제로 삭제함; 신뢰 전까지는 true 유지

# 스토리지 포트-어댑터(선택, ADR 0029) — FileStorage 구현체를 선택한다.
# 기본값은 로컬 디스크(ADR 0005 동작 그대로, 변경 없음). S3_BUCKET/AWS_REGION은
# STORAGE_DRIVER=s3일 때만 필요하다. AWS 자격증명은 ConfigService로 읽지 않는다 —
# AWS SDK 자체의 기본 provider chain이 알아서 찾는데, 이 두 env var도 그 방법 중
# 하나다(공유 config 파일 / IAM 역할도 가능; STORAGE_DRIVER=s3일 때만 필요).
# STORAGE_DRIVER=local             # 'local' | 's3'
# S3_BUCKET=your-bucket-name       # STORAGE_DRIVER=s3일 때 필수
# AWS_REGION=ap-northeast-2        # STORAGE_DRIVER=s3일 때 필수
# AWS_ACCESS_KEY_ID=yourAwsAccessKeyId
# AWS_SECRET_ACCESS_KEY=yourAwsSecretAccessKey

# 로컬 전용 오버라이드: ConfigModule이 .env.local을 .env보다 먼저 읽으므로
# (backend/app.module.ts의 envFilePath: ['.env.local', '.env']), 로컬에서만
# STORAGE_DRIVER를 바꿔 테스트하고 싶으면 .env는 그대로 두고 .env.local에
# STORAGE_DRIVER=s3 한 줄만 넣으면 된다. .env.local은 .gitignore에 이미
# 등록되어 커밋되지 않는다.

# STORAGE_DRIVER=s3일 때 GET /file/:id/content의 presigned-redirect TTL(ADR 0036).
# STORAGE_DRIVER=local일 때는 쓰이지 않는다.
# CONTENT_SIGNED_URL_TTL_SECONDS=300

# 전역 요청 횟수 제한(선택, ADR 0053) — 분당 100회를 모든 라우트에 건다(health/metrics
# 제외, @SkipThrottle()). false면 사실상 무제한으로 우회한다 — e2e 스위트가 같은 인스턴스에
# 순차로 수백 건을 보내 429로 깨지는 것을 막기 위한 테스트 전용 탈출구(test/e2e-env.ts)이며,
# dev/prod에서는 항상 true로 둔다.
# 주석 처리 이유: 위 기본값(true)이 이미 dev/prod가 원하는 값이라 안 써도 되는 것은
# 다른 선택 항목과 같지만, 이 줄은 "다른 값으로 바꿔써도 되는 옵션"이 아니다 — false는
# test/e2e-env.ts 전용이므로, 여기 주석 상태는 "이 값을 건드리지 말라"는 신호다.
# THROTTLE_ENABLED=true
