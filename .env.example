# Development Environment
ENV=dev

# DB configuration
DB_TYPE=yourDatabase
DB_HOST=yourDatabase
DB_PORT=yourPort
DB_USERNAME=yourDBport
DB_PASSWORD=yourDBpassword
DB_DATABASE=yourDBtype

# Hash 
HASH_ROUNDS=hashRounds

# Secret Token
REFRESH_TOKEN_SECRET=yourEncodedSecretKey
ACCESS_TOKEN_SECRET=yourEncodedSecretKey

# Expiry
REFRESH_TOKEN_SECRET_EXPIRES_IN=expiryTime
ACCESS_TOKEN_SECRET_EXPIRES_IN=expiryTime

# Public base URL (optional) — composes file URLs in responses; defaults to http://localhost:3000
# BASE_URL=http://localhost:3000

# CORS (optional) — comma-separated browser origins; leave unset to keep CORS disabled
# CORS_ORIGIN=http://localhost:5173

# Superadmin seed (optional) — this account is promoted to superadmin on boot (ADR 0013);
# leave unset to disable. Register the account first, then set this and restart.
# SUPERADMIN_EMAIL=admin@example.com

# Orphan temp-file sweep (optional, ADR 0018) — deletes unclaimed temp_ uploads
# left in file/temp when POST /file is never called. All have safe defaults.
# TEMP_SWEEP_ENABLED=true          # set false to skip registering the cron (e.g. tests)
# TEMP_SWEEP_CRON=0 * * * *        # schedule; default hourly
# TEMP_SWEEP_TTL_HOURS=24          # a temp_ file older than this is an orphan
# TEMP_SWEEP_DRY_RUN=false         # true logs the deletion targets without deleting

# Storage port-adapter (optional, ADR 0029) — selects the FileStorage implementation.
# Defaults to local disk (ADR 0005 behavior, unchanged). S3_BUCKET/AWS_REGION are only
# required when STORAGE_DRIVER=s3. AWS credentials are NOT read here — the AWS SDK's own
# default provider chain (env vars, shared config, IAM role) resolves them.
# STORAGE_DRIVER=local             # 'local' | 's3'
# S3_BUCKET=your-bucket-name       # required when STORAGE_DRIVER=s3
# AWS_REGION=ap-northeast-2        # required when STORAGE_DRIVER=s3

# Presigned-redirect TTL for GET /file/:id/content under STORAGE_DRIVER=s3 (ADR 0036).
# Unused under STORAGE_DRIVER=local.
# CONTENT_SIGNED_URL_TTL_SECONDS=300
